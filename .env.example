# Copy to .env (git-ignored). Docker compose reads it from this folder; run.bat reads the real environment.

# Admin password: unlocks /admin/, where you create a token per project; callers send theirs as X-Internal-Token.
# Empty = no auth at all (local use only).
TESS_ADMIN_PASSWORD=

# Port the service listens on (compose: the port published by the load balancer).
TESS_PORT=9260

# Compose only: API copies behind nginx. Each runs its own Tesseract processes (a few hundred MB while recognizing).
TESS_REPLICAS=1
# TESS_MEM_LIMIT=1g

# CPU threads for each Tesseract process (OMP_THREAD_LIMIT). Use 1 to 2 when several run at once. A value saved on the
# /admin/ page beats this one.
# TESS_NUM_THREAD=1

# Tunables (update check hours, in-flight cap, answers kept, largest image, pixel limit, time limit, recognitions at
# once, read files at start) are set on the /admin/ Settings card and saved in settings.json. These variables are only a
# starting value for run.bat; compose does not pass them. A saved value wins.
# TESS_UPDATE_CHECK_HOURS=6
# TESS_MAX_INFLIGHT=
# TESS_CACHE_SIZE=256
# TESS_MAX_UPLOAD_MB=10
# TESS_MAX_PIXELS=16000000
# TESS_TIMEOUT_S=110
# TESS_CONCURRENCY=2
# TESS_WARM=1

# run.bat only: the Tesseract program (a name on PATH or a full path) and the folder with the model files
# (models/fast and models/accurate, each holding eng.traineddata). On Windows keep that path free of spaces.
# TESSERACT_CMD=tesseract
# TESS_MODELS_DIR=models

# run.bat only (compose sets these itself): bind address.
# TESS_HOST=127.0.0.1
# Where tokens are stored (hashed) and the admin page folder. Docker sets /data/tokens.json and /app/web.
# TESS_TOKENS_FILE=tokens.json
# TESS_WEB_DIR=web
